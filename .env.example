# Copie este arquivo para .env e ajuste os valores. Nunca commite o .env real.

# --- Banco de dados (Postgres) ---
DB_NAME=barbearia
DB_USER=barbearia
DB_PASSWORD=barbearia

# --- Storage de objetos (MinIO) ---
MINIO_ROOT_USER=barbearia
MINIO_ROOT_PASSWORD=barbearia123
# Endpoint que o backend usa para falar com o MinIO. Dentro do docker-compose
# isso e sobrescrito para http://minio:9000 (nome do servico na rede docker);
# se voce roda o backend fora do docker-compose (ex.: pela IDE), mantenha
# localhost:9000 aqui.
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_COMPROVANTES=comprovantes

# --- Autenticacao (JWT) ---
# Gere um valor aleatorio de pelo menos 32 bytes para producao, por exemplo:
#   openssl rand -base64 48
# Em dev, se omitido, um valor padrao (nao seguro) e' usado — nunca em prod.
JWT_SECRET=troque-este-valor-em-producao-com-openssl-rand-base64-48
JWT_ACCESS_TTL_MINUTOS=15
JWT_REFRESH_TTL_DIAS=7

# --- Usuario administrador inicial ---
# Criado por migration na primeira subida do banco. Se omitido, nenhum
# administrador e' criado automaticamente (use este .env apenas na primeira
# subida; depois disso, gerencie usuarios pelo painel).
ADMIN_EMAIL=admin@barbearia.local
ADMIN_PASSWORD=troque-esta-senha
